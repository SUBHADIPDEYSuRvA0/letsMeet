<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
    <!-- Favicon -->
    <link rel="shortcut icon" href="/img/favicon.ico" type="image/x-icon">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  
<div class="row">
  <div class="col-lg-12">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h2>My Meetings</h2>
      <div>
        <a href="/meetings/new" class="btn btn-primary">
          <i class="fas fa-plus me-2"></i> New Meeting
        </a>
        <a href="/meetings/join" class="btn btn-outline-primary ms-2">
          <i class="fas fa-sign-in-alt me-2"></i> Join Meeting
        </a>
      </div>
    </div>
    
    <ul class="nav nav-tabs mb-4" id="meetingTabs" role="tablist">
      <li class="nav-item" role="presentation">
        <button class="nav-link active" id="hosted-tab" data-bs-toggle="tab" data-bs-target="#hosted" type="button" role="tab">
          Hosted Meetings
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link" id="attended-tab" data-bs-toggle="tab" data-bs-target="#attended" type="button" role="tab">
          Attended Meetings
        </button>
      </li>
    </ul>
    
    <div class="tab-content" id="meetingTabsContent">
      <div class="tab-pane fade show active" id="hosted" role="tabpanel">
        <% if (hostedMeetings && hostedMeetings.length > 0) { %>
          <div class="table-responsive">
            <table class="table table-hover">
              <thead class="table-light">
                <tr>
                  <th>Title</th>
                  <th>Meeting Code</th>
                  <th>Date</th>
                  <th>Status</th>
                  <th>Participants</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% hostedMeetings.forEach(function(meeting) { %>
                  <tr>
                    <td><%= meeting.title %></td>
                    <td><code><%= meeting.roomCode %></code></td>
                    <td><%= new Date(meeting.startTime).toLocaleString() %></td>
                    <td>
                      <% if (meeting.isActive) { %>
                        <span class="badge bg-success">Active</span>
                      <% } else { %>
                        <span class="badge bg-secondary">Ended</span>
                      <% } %>
                    </td>
                    <td><%= meeting.participants.length %></td>
                    <td>
                      <div class="btn-group">
                        <a href="/meetings/<%= meeting._id %>" class="btn btn-sm btn-outline-primary">
                          <i class="fas fa-info-circle"></i>
                        </a>
                        <% if (meeting.isActive) { %>
                          <a href="/meetings/join/<%= meeting.roomCode %>" class="btn btn-sm btn-outline-success">
                            <i class="fas fa-sign-in-alt"></i>
                          </a>
                        <% } %>
                        <button class="btn btn-sm btn-outline-secondary copy-btn" data-clipboard-text="<%= meeting.roomCode %>">
                          <i class="fas fa-copy"></i>
                        </button>
                      </div>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="alert alert-info">
            <i class="fas fa-info-circle me-2"></i> You haven't hosted any meetings yet.
          </div>
        <% } %>
      </div>
      
      <div class="tab-pane fade" id="attended" role="tabpanel">
        <% if (attendedMeetings && attendedMeetings.length > 0) { %>
          <div class="table-responsive">
            <table class="table table-hover">
              <thead class="table-light">
                <tr>
                  <th>Title</th>
                  <th>Meeting Code</th>
                  <th>Date</th>
                  <th>Status</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% attendedMeetings.forEach(function(meeting) { %>
                  <tr>
                    <td><%= meeting.title %></td>
                    <td><code><%= meeting.roomCode %></code></td>
                    <td><%= new Date(meeting.startTime).toLocaleString() %></td>
                    <td>
                      <% if (meeting.isActive) { %>
                        <span class="badge bg-success">Active</span>
                      <% } else { %>
                        <span class="badge bg-secondary">Ended</span>
                      <% } %>
                    </td>
                    <td>
                      <div class="btn-group">
                        <a href="/meetings/<%= meeting._id %>" class="btn btn-sm btn-outline-primary">
                          <i class="fas fa-info-circle"></i>
                        </a>
                        <% if (meeting.isActive) { %>
                          <a href="/meetings/join/<%= meeting.roomCode %>" class="btn btn-sm btn-outline-success">
                            <i class="fas fa-sign-in-alt"></i>
                          </a>
                        <% } %>
                      </div>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="alert alert-info">
            <i class="fas fa-info-circle me-2"></i> You haven't attended any meetings yet.
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<script>
  // Initialize clipboard.js
  document.addEventListener('DOMContentLoaded', function() {
    const clipboard = new ClipboardJS('.copy-btn');
    
    clipboard.on('success', function(e) {
      const button = e.trigger;
      const originalHTML = button.innerHTML;
      
      button.innerHTML = '<i class="fas fa-check"></i>';
      setTimeout(function() {
        button.innerHTML = originalHTML;
      }, 2000);
      
      e.clearSelection();
    });
  });
</script>
</body>
</html>