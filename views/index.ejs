

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
    <!-- Favicon -->
    <link rel="shortcut icon" href="/img/favicon.ico" type="image/x-icon">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="row align-items-center py-5">
  <div class="col-lg-6">
    <h1 class="display-4 fw-bold text-primary mb-3">Video meetings for everyone</h1>
    <p class="lead mb-4">Secure, reliable, and high-quality video conferencing with all the features you need.</p>
    
    <div class="d-flex flex-wrap gap-2 mb-4">
      <% if (typeof user !== 'undefined' && user) { %>
        <a href="/meetings/new" class="btn btn-primary btn-lg">
          <i class="fas fa-video me-2"></i> New Meeting
        </a>
        
        <form action="/meetings/join" method="POST" class="d-flex">
          <input type="text" name="roomCode" class="form-control form-control-lg me-2" placeholder="Enter meeting code" required>
          <button type="submit" class="btn btn-outline-primary btn-lg">
            <i class="fas fa-sign-in-alt"></i>
          </button>
        </form>
      <% } else { %>
        <a href="/auth/login" class="btn btn-primary btn-lg">
          <i class="fas fa-sign-in-alt me-2"></i> Sign in to start a meeting
        </a>
      <% } %>
    </div>
    
    <p class="text-muted">Don't have an account? <a href="/auth/register">Sign up for free</a></p>
  </div>
  
  <div class="col-lg-6">
    <img src="/img/hero-image.svg" alt="Video conference illustration" class="img-fluid">
  </div>
</div>

<div class="bg-light py-5 mt-5">
  <div class="container">
    <h2 class="text-center mb-5">Everything you need for seamless meetings</h2>
    
    <div class="row g-4">
      <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm">
          <div class="card-body text-center p-4">
            <div class="feature-icon bg-primary bg-gradient text-white rounded-circle mb-3">
              <i class="fas fa-video"></i>
            </div>
            <h5 class="card-title">HD Video Conferencing</h5>
            <p class="card-text">Crystal clear video and audio for all your meetings.</p>
          </div>
        </div>
      </div>
      
      <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm">
          <div class="card-body text-center p-4">
            <div class="feature-icon bg-primary bg-gradient text-white rounded-circle mb-3">
              <i class="fas fa-comments"></i>
            </div>
            <h5 class="card-title">In-meeting Chat</h5>
            <p class="card-text">Send messages to everyone or privately during calls.</p>
          </div>
        </div>
      </div>
      
      <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm">
          <div class="card-body text-center p-4">
            <div class="feature-icon bg-primary bg-gradient text-white rounded-circle mb-3">
              <i class="fas fa-desktop"></i>
            </div>
            <h5 class="card-title">Screen Sharing</h5>
            <p class="card-text">Share your screen with participants with one click.</p>
          </div>
        </div>
      </div>
      
      <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm">
          <div class="card-body text-center p-4">
            <div class="feature-icon bg-primary bg-gradient text-white rounded-circle mb-3">
              <i class="fas fa-record-vinyl"></i>
            </div>
            <h5 class="card-title">Recording</h5>
            <p class="card-text">Record your meetings for later reference.</p>
          </div>
        </div>
      </div>
      
      <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm">
          <div class="card-body text-center p-4">
            <div class="feature-icon bg-primary bg-gradient text-white rounded-circle mb-3">
              <i class="fas fa-sync"></i>
            </div>
            <h5 class="card-title">Camera Controls</h5>
            <p class="card-text">Rotate camera, apply filters, and more.</p>
          </div>
        </div>
      </div>
      
      <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm">
          <div class="card-body text-center p-4">
            <div class="feature-icon bg-primary bg-gradient text-white rounded-circle mb-3">
              <i class="fas fa-shield-alt"></i>
            </div>
            <h5 class="card-title">Secure Meetings</h5>
            <p class="card-text">End-to-end encryption for all your conversations.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
  
</body>
</html>